{
    "version": 10,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/out/build",
            "installDir": "${sourceDir}/out/install",
            "cacheVariables": {
                "CMAKE_IS_BROKEN": "false",
                "CMAKE_SYSTEM_NAME": "Windows",
                "CMAKE_SYSTEM_VERSION": "10.0.20348.0",
                "CMAKE_VS_PLATFORM_TOOLSET_VERSION": "14.29.30133"
            }
        },
        {
            "name": "x86",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_SYSTEM_PROCESSOR": "X86",
                "IS_X64": "false"
            }
        },
        {
            "name": "ClangCl",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER_FRONTEND_VARIANT": "MSVC",
                "CMAKE_CXX_COMPILER_FRONTEND_VARIANT": "MSVC",
                "CLANG_TYPE": "CLANG-CL",
                "CUSTOM_CLANG": "false"
            }
        },
        {
            "name": "Release-Debug",
            "inherits": ["base"],
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_C_FLAGS_RELWITHDEBINFO": "/MT /Zi /O2 /Ob2 /DNDEBUG",
                "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "/MT /Zi /O2 /Ob2 /DNDEBUG",
                "SIZE_OPTIMIZE": "false",
                "STATIC_CSOUND": "false"
            }
        },
        {
            "name": "x86-Clang-Release-Debug",
            "inherits": ["x86", "ClangCl", "Release-Debug"]
        },
        {
            "name": "GNUmake",
            "hidden": true,
            "generator": "MinGW Makefiles",
            "toolchainFile": "dobby/WindowsToolchain/Windows.Clang.toolchain.cmake",
            "cacheVariables": {
                "VS_PLATFORM_TOOLSET_VERSION": "14.29.30133"
            }
        },
        {
            "name": "x86-Clang-Release-Debug-GNUmake",
            "inherits": ["x86-Clang-Release-Debug", "GNUmake"]
        }
    ],
    "buildPresets": [
        {
            "name": "UMTest1",
            "configurePreset": "x86-Clang-Release-Debug-GNUmake",
            "targets": "UMTest1"
        }
    ]
}
